# ---------------------------------------------------------------------------
# Copia este fichero a `.env` y rellénalo. NO subas el .env al repositorio.
# Genera los secretos con:  openssl rand -hex 24
# ---------------------------------------------------------------------------

# --- Infraestructura ---
POSTGRES_PASSWORD=cambia-esto-por-algo-largo
EVOLUTION_API_KEY=cambia-esto-por-algo-largo
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_INSTANCIA=ventas

# Token que va en la URL del webhook: POST /webhook/<WEBHOOK_TOKEN>
# Sin él, cualquiera que alcance el puerto podría inyectar ventas falsas.
WEBHOOK_TOKEN=cambia-esto-por-algo-largo

# --- Blindaje del grupo ---
# JID del grupo de ventas. Se saca con: docker compose exec bot python -m tools.gestion grupos
# Mientras esté vacío, el bot no escucha NADA (comportamiento deliberado).
GRUPO_VENTAS_JID=
# Opcional, para pruebas: otros chats permitidos, separados por comas.
JIDS_EXTRA_PERMITIDOS=

# --- Extracción con IA ---
# anthropic | gemini | ollama
LLM_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=sk-ant-...
MODELO_TEXTO=claude-haiku-4-5
MODELO_VISION=claude-sonnet-5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=90
# true: los PDFs sin capa de texto se mandan enteros al modelo.
# false: se rasterizan con poppler y se mandan como imagen (necesario en Ollama).
PDF_NATIVO=true

# Alternativas (solo si cambias LLM_PROVEEDOR)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.0-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODELO=llama3.2-vision

# --- Almacenamiento ---
DB_PATH=/datos/ventas.db

# --- Procesado de adjuntos ---
MAX_MEDIA_MB=20
PDF_MAX_PAGINAS=2
PDF_MIN_CARACTERES=80
PDF_DPI=200

# --- Comportamiento ---
RESPONDER_EN_GRUPO=true
RESPONDER_ERRORES=true
COMANDOS_ACTIVOS=true
COLA_MAX=200
ZONA_HORARIA=Europe/Madrid
LOG_LEVEL=INFO
